{
  "name": "pdf-editor-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run server:install",
    "server:install": "npm --prefix server ci --include=dev",
    "dev": "npm run server:build && next dev --webpack",
    "build": "npm run server:install && npm run server:build && next build",
    "build:static": "npm run server:install && npm run server:build && BLOOM_STATIC_EXPORT=1 next build",
    "serve:out": "serve out -l 4174 --no-clipboard",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "server:build": "npm --prefix server run build",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "pako": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-signature-canvas": "^1.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "happy-dom": "^20.10.6",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.1.200",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4"
  }
}
